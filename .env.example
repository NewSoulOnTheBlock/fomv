# --- Read path (no key required) ---------------------------------------------
# Watching a leader, computing target portfolios and NAV all work with no key.
HL_API_URL=https://api.hyperliquid.xyz

# --- Leader ------------------------------------------------------------------
# Any Hyperliquid address. A fomo trader's perp account is a Hyperliquid
# account, so their live positions are readable from the public info endpoint.
LEADER_ADDRESS=

# --- Execution (leave blank to stay in dry-run) -------------------------------
# Dedicated agent/API wallet key, approved via `approveAgent` on the master
# account that owns the vault. Never use your master key here.
HL_AGENT_PRIVATE_KEY=

# Account holding vault capital: a subaccount of the master account.
# Subaccounts have no private key; the agent signs and this goes in the
# action's `vaultAddress` field.
HL_VAULT_ADDRESS=

# dry-run | live
MODE=dry-run
