# --- RPC ----------------------------------------------------------------------
# Account state: balances, mints, pool liquidity, holder concentration.
SOLANA_RPC_URL=

# Transaction history. Split from the above on purpose: archival history and
# indexed account queries are rarely served well by the same endpoint, and the
# free ones each refuse a different half of what this needs.
#
#   api.mainnet-beta.solana.com   refuses BATCHED transaction reads
#   solana-rpc.publicnode.com     refuses INDEXED methods
#                                 (getTokenLargestAccounts, token-account scans)
#
# Holder concentration needs the indexed methods, so a free endpoint means
# either turning off safety.requireHolderData or trading blind on it. Use a
# real provider (Helius / Triton / QuickNode).
SOLANA_TX_RPC_URL=

# --- Leader -------------------------------------------------------------------
# The fomo trader being mirrored. fomo wallets are self-custodial, so their
# swaps are readable straight off-chain -- no fomo API or partnership needed.
LEADER_ADDRESS=

# --- Execution (leave blank to stay in dry-run) --------------------------------
# Signs the vault's mirror swaps. Base58 or a JSON byte array.
SOLANA_VAULT_PRIVATE_KEY=

# dry-run | live
MODE=dry-run

# --- Routing ------------------------------------------------------------------
# Verified live hosts:
#   https://lite-api.jup.ag/swap/v1   keyless
#   https://api.jup.ag/swap/v1        requires JUPITER_API_KEY
# quote-api.jup.ag/v6 is dead; do not use it.
JUPITER_API_URL=
JUPITER_API_KEY=

# --- FOMV platform ------------------------------------------------------------
# Receives listing fees in SOL and withdrawal fees as vault shares.
FOMV_TREASURY=

# Reprices fees and lists vaults. Never has custody of vault assets.
FOMV_AUTHORITY=

# Protocol skim on every withdrawal, in bps. The program caps this at 200
# (2%) and a listed vault keeps whatever figure it was listed under.
FOMV_WITHDRAW_FEE_BPS=100

# One-off charge for a trader to be listed, in lamports. 5 SOL by default.
FOMV_LISTING_FEE_LAMPORTS=5000000000
