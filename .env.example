# --- RPC ----------------------------------------------------------------------
# Account state: balances, mints, pool liquidity, holder concentration.
SOLANA_RPC_URL=

# Transaction history. Split from the above on purpose: archival history and
# indexed account queries are rarely served well by the same endpoint, and the
# free ones each refuse a different half of what this needs.
#
#   api.mainnet-beta.solana.com   refuses BATCHED transaction reads
#   solana-rpc.publicnode.com     refuses INDEXED methods
#                                 (getTokenLargestAccounts, token-account scans)
#
# Holder concentration needs the indexed methods, so a free endpoint means
# either turning off safety.requireHolderData or trading blind on it. Use a
# real provider (Helius / Triton / QuickNode).
SOLANA_TX_RPC_URL=

# --- Leader -------------------------------------------------------------------
# The fomo trader being mirrored. fomo wallets are self-custodial, so their
# swaps are readable straight off-chain -- no fomo API or partnership needed.
LEADER_ADDRESS=

# --- Execution (leave blank to stay in dry-run) --------------------------------
# Signs the vault's mirror swaps. Base58 or a JSON byte array.
SOLANA_VAULT_PRIVATE_KEY=

# dry-run | live
MODE=dry-run

# --- Routing ------------------------------------------------------------------
# Verified live hosts:
#   https://lite-api.jup.ag/swap/v1   keyless
#   https://api.jup.ag/swap/v1        requires JUPITER_API_KEY
# quote-api.jup.ag/v6 is dead; do not use it.
JUPITER_API_URL=
JUPITER_API_KEY=

# --- FOMV platform ------------------------------------------------------------
# Receives listing fees in SOL and withdrawal fees as vault shares.
FOMV_TREASURY=

# Reprices fees and lists vaults. Never has custody of vault assets.
FOMV_AUTHORITY=

# Protocol skim on every withdrawal, in bps. The program caps this at 200
# (2%) and a listed vault keeps whatever figure it was listed under.
FOMV_WITHDRAW_FEE_BPS=100

# One-off charge for a trader to be listed, in lamports. 5 SOL by default.
FOMV_LISTING_FEE_LAMPORTS=5000000000

# --- Follow server ------------------------------------------------------------
# Privy app credentials. The secret is server-only and must never be exposed to
# the browser; the app id is public and lives in app/.env as VITE_PRIVY_APP_ID.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Private key of the app's authorisation keypair, if one is registered in the
# Privy dashboard. Required for wallet RPC when set up -- it proves a signing
# request came from this server rather than anyone holding the app secret.
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Where SQLite lives. Mount a volume in production: losing it loses every
# subscriber cursor and the record of which trades were already mirrored.
FOMV_DB_PATH=state/follow.sqlite

# Browser origins allowed to call the API. Explicit, never "*", because these
# endpoints carry a bearer token.
FOMV_ALLOWED_ORIGINS=https://fomv.vercel.app,http://localhost:5173

# Seconds between mirror cycles.
FOMV_POLL_INTERVAL_SEC=10

# Cut of each mirrored trade, in bps. Capped at 100 by the engine, and the
# default now sits at that ceiling -- raising the published rate takes a code
# change and a release, which is weaker than a program constraint but not
# nothing.
FOMV_TRADE_FEE_BPS=100

# The leader's share of that fee, in bps of the fee. 5000 is an even split.
#
# Expressed against the fee rather than against the trade, so changing the
# headline rate does not silently change who gets what.
FOMV_LEADER_SHARE_BPS=5000

# Bearer token guarding GET /admin/applications, the trader-listing inbox.
#
# Absent means the endpoint is not served at all, rather than served openly.
# An admin route that falls back to "open" when its secret is missing is how a
# lead list ends up public the first time an environment variable is forgotten.
# Generate one with: openssl rand -hex 32
FOMV_ADMIN_TOKEN=
