# Privy app id. Without it sign-in is disabled; the dashboard still works.
VITE_PRIVY_APP_ID=

# Skiper UI Pro licence. Read by the shadcn CLI via components.json when
# installing gated components such as @skiper-ui/skiper21. Build-time only --
# never exposed to the browser, which is why it has no VITE_ prefix.
SKIPER_UI_LICENSE=
