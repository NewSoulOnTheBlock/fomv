# Privy app id. Without it sign-in is disabled; the dashboard still works.
VITE_PRIVY_APP_ID=

# Session signer id, from the Privy dashboard.
#
# Required to authorise trade signing. This app's wallets are TEE-backed, so
# delegation is granted via session signers rather than the older delegated
# actions API -- the two are not interchangeable and the old one errors out.
#
# Create one under Wallet infrastructure > Session signers (or Key quorums) in
# the Privy dashboard, then paste its id here. Without it the Authorise button
# is disabled and says so.
VITE_PRIVY_SIGNER_ID=

# Base URL of the follow server. Leave blank to run the dashboard read-only.
VITE_FOMV_API=
