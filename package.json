{
  "name": "fomo-vaults",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pooled copy-trading vaults that mirror a fomo trader's Hyperliquid perp positions by portfolio weight.",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "watch": "bun run src/cli.ts watch",
    "nav": "bun run src/cli.ts nav",
    "simulate": "bun run src/cli.ts simulate",
    "build:web": "bun run scripts/build-web.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
